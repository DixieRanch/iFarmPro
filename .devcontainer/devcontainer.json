// .devcontainer/devcontainer.json
{
  "name": "Ubuntu 20.04 Dev Environment",
  "dockerComposeFile": "docker-compose.yml",
  "service": "dev-environment",
  "workspaceFolder": "/workspaces/iFarmPro",
  "postCreateCommand": [
    "export PATH=\"/workspaces/iFarmPro/bin:$PATH\"",
    "/home/codespaces/.rbenv/bin/rbenv exec bundle install",
    "bundle exec rake db:setup db:test:prepare db:seed RAILS_ENV=test"
  ]
}
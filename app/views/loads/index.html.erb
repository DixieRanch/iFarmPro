<% provide :title, 'Inventory' %>
<div class="row col-md-6">
<table id='locations' class='table table-striped'>
  <thead>
    <h1>Location Overview</h1>
    <h3>Total Net Weight: <%= @totals[:weight] %></h3>
    <h3>Total Lot Count: <%= @totals[:count] %></h3>
    <h3>#1 Weight: <%= @totals[:content][:type1s] %></h3>
    <h3>#2 Weight: <%= @totals[:content][:type2s] %></h3>
    <h3>#3 Weight: <%= @totals[:content][:type3s] %></h3>
    <h3>Blacks Weight: <%= @totals[:content][:typeBlacks] %></h3>
    <h3>Cracks Weight: <%= @totals[:content][:typeCracks] %></h3>
    <h3>Pre-Clean Weight: <%= @totals[:content][:typePreClean] %></h3>
    <tr>
      <th>Location Name</th>
      <th>Net Weight</th>
      <th>Location Contents</th>
      <th>Lot Count</th> 
    </tr>
  </thead>
  <tbody>
    <% @loads.each_with_index do |ld, l| %>
    <tr>
      <td id="name<%=l%>"><%= ld.location.name %></td>
      <td id="weight<%=l%>"><%= ld.weight %></td>
      <td id="location_contents<%=l%>"><%= ld.location_contents %></td>
      <td id="lot_count<%=l%>"><%= ld.lot_count %></td>
      <td>
        <%= link_to 'Move All Lots', edit_load_path(ld.location), 
                                     id:"link_#{l}",
                                     class: 'btn-sm btn-primary',
                                     role: 'button'
        %>
        
        <%= link_to 'Ship Location', new_shipment_selection_path(location: ld.location.id), 
                                     id:"link_#{l}",
                                     class: 'btn-sm btn-primary',
                                     role: 'button'
        %>
      </td>
    </tr>
    <% end %>
  </tbody>
</table>
<%= will_paginate @loads %>
</div>
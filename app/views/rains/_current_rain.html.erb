<h1>Current Rain</h1>

<table id="rain_table" class="table">
  <thead>
  <tr>
    <th>Amount</th>
    <th>Date</th>
  </tr>
  </thead>
  <tbody>
  <% if @rains.present? %>
      <% @rains.each_with_index do |rain, i| %>
          <tr>
            <td id="amount_<%=i%>"><%= rain.amount %></td>
            <td id="date_<%=i%>"><%= rain.formatted_date %></td>
            <td><%= link_to 'Edit', edit_rain_path(rain), id: "link_#{i}", class: 'btn btn-primary' %></td>
          </tr>
      <% end %>
  <% end %>
  </tbody>
</table>
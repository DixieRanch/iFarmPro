<h1>Shipping <%= @shipping.location.name %> to <%= @shipment.name %> </h1>

<div class="row col-md-6">
  
    <h3>Total shipped weight: <%= @shipping.shipped_weight %></h3>
    <table id='shipping_lots' class='table table-striped'>
      <thead>
          <tr>
              <th>Lot Name</th>
              <th>Box Name</th>
          </tr>
      </thead>
      <tbody>
          <% @shipping.location.lots.each_with_index do |lot, l| %>
          <tr>
              <td id="name<%=l%>"><%= lot.name %></td>
              <td id="name<%=l%>"><%= lot.box.name %></td>
              <td>
              <%= simple_form_for lot, :url => shipping_path(id: @shipment.id), html: {class: 'form-inline'} do |f| %>
                <fieldset>
                  <%= f.hidden_field :id, value: lot.id, label: 'lot' %>
                </fieldset>
                  <%= f.submit 'Ship', class: 'btn btn-primary pull-left' %>
              
              <% end %>
              </td>
          </tr>
          <% end %>
      </tbody>
    </table>
</div>
  
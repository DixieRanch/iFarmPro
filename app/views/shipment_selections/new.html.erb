 <% provide :title, 'Shipment Selection' %>
 
 <h1>Shipping location <%= @location.name %></h1>
 
 <%= simple_form_for @shipment_selection, html: {class: 'form-inline'} do |f| %>
    <fieldset> 
     <%= f.input :shipment_id,
                 collection: Shipment.all.sort_by(&:name),
                 label_method: :name,
                 include_blank: false 
     %>
     
     <%= f.hidden_field :location, value: @location.id, label: 'location' %>
     <fieldset>
     
     <%= f.submit 'Select', class: 'btn btn-primary pull-left' %>
 <% end %>
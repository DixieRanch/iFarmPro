<table id="irrigation_table" class="table table-striped">
  <thead>
    <caption><h1>Current Irrigations</h1></caption>
    <tr>
      <th>Field</th>
      <th>Last Irrigation</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% @irrigations.each_with_index do |irrigation, i| %>
      <tr>
        <td id="field<%=i%>"><%= irrigation.field.name_with_block %></td>
        <td id="irrigation<%=i%>"><%= irrigation.formatted_time %></td>
        <td>
          <%= link_to 'edit', edit_irrigation_path(irrigation),
                              id: "link_#{i}",
                              class: 'btn-sm btn-primary',
                              role: 'button' %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
<% if current_user %> 
  <div class="row">
    <div class="col-xs-5 col-sm-3" id="sidebar" role="navigation">
      <%= render 'layouts/sidebar' %>
    </div>
    <div class="col-xs-12 col-sm-9">
      <% flash.each do |key, value| %>
        <%= content_tag(:div, value, class: "alert alert-#{key}") %>
      <% end %>
      <%= yield %>
    </div>
  </div>
<% else %>
  <% flash.each do |key, value| %>
    <%= content_tag(:div, value, class: "alert alert-#{key}") %>
  <% end %>
  <%= yield %>
<% end %>
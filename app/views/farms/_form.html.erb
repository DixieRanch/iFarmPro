<%= simple_form_for @farm do |f| %>
  <%= f.error_notification %>
  <%= f.input :name, label: 'Farm Name' %>
  <%= f.association :weather_station,
                    label: 'Weather Station',
                    collection: WeatherStation.order("name"),
                    include_blank: false %>
    <%= f.simple_fields_for :irrigation_wells do |builder| %>
      <%= render 'irrigation_well_fields', f: builder  %>
    <% end %>
    <%= link_to_add_fields "Add Irrigation Well", f, :irrigation_wells %>
    <%= f.simple_fields_for :blocks do |builder| %>
      <%= render 'block_fields', f: builder %>
    <% end %>
    <%= link_to_add_fields "Add Block", f, :blocks %><br />
  <%= f.submit "Save", class: "btn btn-large btn-primary" %>
<% end %>
{
  "name": "iFarmPro Ruby 2.4.2 Dev Container",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-20.04",
  "features": {
    "ghcr.io/devcontainers/features/ruby": {
      "version": "2.4.2"
    },
    // Postgres is now provided via Docker Compose service. See docker-compose.yml.
  },
  "dockerComposeFile": ["../docker-compose.yml"],
  "service": "devcontainer",
  "postCreateCommand": "bundle install",
  "customizations": {
    "vscode": {
      "settings": {},
      "extensions": [
        "castwide.solargraph"
      ]
    }
  }
}

<%= simple_form_for @lot, html: {class: 'form-inline'} do |f| %>

  <fieldset>
    <%= f.input :name,
                label: 'Lot Name',
                wrapper_html: {class: 'col-xs-5 col-sm-3 col-md-2'} %>
    
    <%= f.input :full_weight,
                label: 'Full Weight',
                wrapper_html: {class: 'col-xs-5 col-sm-3 col-md-2'} %>
                
    <%= f.association :box,
                      collection: Box.all.sort_by(&:name),
                      lable_method: :name,
                      include_blank: false,
                      wrapper_html: 
                  {class: 'col-xs-6 col-sm-5 col-md-4 col-lg-3 nopadxs'} %>
  </fieldset>
<% end %>
<%= simple_form_for @product, html: {class: 'form-inline'} do |f| %>
  <%= f.error_notification %>
  <fieldset>
    <%= f.input :name %>
    <%= f.input :n, as: :tel %>
    <%= f.input :p, as: :tel %>
    <%= f.input :k, as: :tel %>
    <%= f.input :s, as: :tel %>
  </fieldset>
  <%= f.button :submit, 'Save', class: 'btn-primary' %>
<% end %>
<table id='storage_locations' class='table table-striped'>
    <thead>
        <h1>Locations</h1>
        
        <tr>
            <th>Location Name</th>
        </tr>
    </thead>
    
    <tbody>
        <% @freezer_locations.each_with_index do |location, l| %>
        <tr>
            <td id="name<%=l%>"><%= location.name %></td>
            <td>
                <%= link_to 'edit', edit_freezer_location_path(location),
                                    id: "link_#{l}"%>
            </td>
        </tr>
        <% end %>
    </tbody>
</table>
<%= will_paginate @freezer_locations %>
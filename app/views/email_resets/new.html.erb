<%provide :title, "Change Email"%>

<div class="col-xs-10 col-md-8">
  <div class="panel panel-primary">
    <div class="panel-heading"><h1>Change Email</h1></div>
    <div class="panel-body">
      
      
      <%= simple_form_for :email_resets, 
                          url: email_resets_path,
                          html: {class: 'form-horizontal'},
                          wrapper: :horizontal_form do |f| %>
        <%= f.submit 'Submit Email', class: "btn btn-lg btn-primary" %>
      <% end %>
    </div>
  </div>
</div>
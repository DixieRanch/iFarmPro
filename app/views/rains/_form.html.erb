<%= simple_form_for @rain do |f| %>
 <%= f.error_notification %>
 <div class="controls-row">
  <div class="span2">
    <%= f.input :date, as: :tel, 
                input_html: { class: 'input-small',
                              value: @rain.formatted_date } %>
  </div>
  <div class="span2">
   <%= f.input :amount, as: :tel, input_html: { class: 'input-mini' } %>
  </div>
 </div>
  <%= f.button :submit, 'Save', class: 'btn-primary' %>
<% end %>
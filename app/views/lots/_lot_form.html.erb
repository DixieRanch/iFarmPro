<%= simple_form_for @lot, html: {class: 'form-inline'} do |f| %>

  <fieldset>
    <%= f.input :name,
                label: 'Lot Name' %>
    
    <%= f.input :full_weight,
                label: 'Full Weight' %>
                
    <%= f.input :box_name,
                label: 'Box Name',
                error: 'Box not found'%>
                  
    <%= f.input :freezer_location_id,
                      collection: FreezerLocation.all.sort_by(&:name),
                      label_method: :name,
                      include_blank: false %>   
                  
    <%= f.input :block_id,
                      collection: Block.all.sort_by(&:name),
                      label_method: :name,
                      include_blank: false %> 
    
    <%= f.input :field_name,
                      label: 'Field' %> 
    
    <%= f.input :content_id,
                      collection: Content.all.sort_by(&:name),
                      label: 'Contents',
                      label_method: :name,
                      include_blank: true %> 
    
  </fieldset>
  
  <%= f.submit 'Save', class: 'btn btn-primary pull-left' %>
<% end %>
<h1>Shipping <%= @location.name %> to <%= @shipment.name %> </h1>

<div class="row col-md-6">
    <table id='shipping_lots' class='table table-striped'>
      <thead>
          <tr>
              <th>Lot Name</th>
          </tr>
      </thead>
      <tbody>
          <% @location.lots.each_with_index do |lt, l| %>
          <tr>
              <td
              <%= simple_form_for lt, html: {class: 'form-inline'} do |f| %>
                <fieldset>
                  <%= f.hidden_field :lot, value: lt.id, label: 'lot' %>
                  <%= f.submit 'Ship', class: 'btn btn-primary pull-left' %>
                </fieldset>
              
              <% end %>
              </td>
              <td id="name<%=l%>"><%= lt.name %></td>
              <td>
                  <%= link_to 'Ship Lot', edit_shipping_path(lot: lt.id, 
                                              id: @shipment.id),
                                          id:"link_#{l}",
                                          class: 'btn-sm btn-primary',
                                          role: 'button'
                   %>
              </td>
          </tr>
          <% end %>
      </tbody>
    </table>
</div>
  
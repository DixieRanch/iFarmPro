    <table id='shipments' class='table table-striped'>
    <thead>
       <th>Name</th>
       <th>Date</th>
       <th>Destination</th>
    </thead>
   <tbody>
        <% @shipments.each_with_index do |shipment, s| %>
        <tr>
            <td id="name<%=s%>"><%= shipment.name %></td>
            <td id="date<%=s%>"><%= shipment.date %></td>
            <td id="destination<%=s%>"><%= shipment.destination %></td>
            <td>
                <%= link_to 'edit', edit_shipment_path(shipment),
                            id: "link_#{s}",
                            class: 'btn-sm btn-primary',
                            role: 'button'
                %>
            </td>

        </tr>
        <% end %>
            </tbody>
</table>
{
  "name": "iFarmPro Ruby 2.4.2 Dev Container",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-20.04",
  "features": {
    "ghcr.io/devcontainers/features/ruby": {
      "version": "2.4.2"
    },
    // PostgreSQL version downgraded from 16.3 to 15.12 due to compatibility requirements with the 'pg' gem (ActiveRecord PostgreSQL adapter) and legacy migration scripts.
    "ghcr.io/devcontainers/features/postgres": {
      "version": "15.12"
    }
  },
  "postCreateCommand": "bundle install",
  "customizations": {
    "vscode": {
      "settings": {},
      "extensions": [
        "castwide.solargraph"
      ]
    }
  }
}

<% provide :title, @farm.name %>
<div class="row col-sm-8 col-md-6">
  <div class="panel panel-primary">
    <div class="panel-heading"><h1><%= @farm.name %></h1></div>
    <div class="panel-body">
      <table id="farms_table" class="table table-striped">
        <thead>
          <tr>
            <th>Block</th>
            <th>Field</th>
            <th>Soil Type</th>
            <th>Acres</th>
          </tr>
        </thead>
        <tbody>
          <% @farm.blocks.each do |block| %>
            <tr>
              <td><%= block.name %></td>
              <td>
                <table id="fields_table">
                  <% block.fields.each do |field| %>
                    <tr>
                      <td><%= field.name %></td>
                    </tr>
                  <% end %>
                </table>
              </td>
              <td>
                <table id="soil_types_table">
                  <% block.fields.each do |field| %>
                    <tr>
                      <td><%= field.soil_class.name %></td>
                    </tr>
                  <% end %>
                </table>
              </td>
              <td>
                <table id="field_acreage_table">
                  <% block.fields.each do |field| %>
                    <tr>
                      <td><%= field.acreage %></td>
                    </tr>
                  <% end %>
                </table>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
      <%= link_to 'Edit', edit_farm_path(@farm), class: 'btn btn-primary' %>
      <%= link_to 'Back to Farms', farms_path, class: 'btn btn-default' %>
    </div>
  </div>
</div>
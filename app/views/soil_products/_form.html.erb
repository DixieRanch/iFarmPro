<%= simple_form_for @product do |f| %>
  <%= f.error_notification %>
    <div class="controls-row">
      <div class="span2">
        <%= f.input :name, input_html: { class: 'input-small' } %>
      </div>
      <div class="span1">
        <%= f.input :n, as: :tel, input_html: { class: 'input-mini' } %>
      </div>
      <div class="span1">
        <%= f.input :p, as: :tel, input_html: { class: 'input-mini'} %>
      </div>
      <div class="span1">
        <%= f.input :k, as: :tel, input_html: { class: 'input-mini'} %>
      </div>
      <div class="span1">
        <%= f.input :s, as: :tel, input_html: { class: 'input-mini'} %>
      </div>
    </div>
  <%= f.button :submit, 'Save', class: 'btn-primary' %>
<% end %>
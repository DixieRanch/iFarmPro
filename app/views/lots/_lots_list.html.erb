<table id='lots' class='table table-striped'>
  <thead>
    <h1>Lots</h1>
    
    <tr>
      <th>Lot Name</th>
      <th>Lot Weight</th>
      <th>Box Name</th>
    </tr>
  </thead>
  <tbody>
    <% @lots.each_with_index do |lot, l| %>
    <tr>
      <td id="name<%=l%>"><%= lot.name %></td>
      
      <td id="full_weight<%=l%>"><%= lot.full_weight %></td>
      
      <td id="box_id<%=l%>"><%= lot.box.name %></td>
    </tr>
    <% end %>
  </tbody>
</table>
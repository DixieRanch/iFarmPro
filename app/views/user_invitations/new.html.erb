<% provide :title, 'Invite User' %>
<div class="row">
  <div class="panel panel-primary">
    <div class="panel-heading"><h1>Invite New User</h1></div>
    <div class="panel-body">
      <%= simple_form_for(@invitation) do |f| %>
        <%= f.error_notification %>
        <fieldset>
          <%= f.input :email %>
        </fieldset>
        <%= f.submit "Send Invitation", class: "btn btn-large btn-primary" %>
      <% end %>
    </div>
  </div>
</div>
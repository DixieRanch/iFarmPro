<h1>Return <%= @lot.name %> to Storage</h1>

<%= simple_form_for @manifest.lot, html: {class: 'form-inline'} do |f| %>
    <%= f.input :freezer_location_id,
                    collection: FreezerLocation.all.sort_by(&:name),
                    label: 'Location',
                    label_method: :name,
                    include_blank: false
    %>
    
    <%= f.submit 'Move Lot', class: 'btn btn-primary pull-left' %>
<% end %>
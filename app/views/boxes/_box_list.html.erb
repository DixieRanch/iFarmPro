<table id="containers_table" class="table table-striped">
  <thead>
    <caption><h1>Current Containers</h1></caption>
    <tr>
      <th>Box</th>
      <th>Empty Weight</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% @boxes.each_with_index do |container, i| %>
      <tr>
        <td id="name<%=i%>"><%= container.name %></td>
        <td id="weight<%=i%>"><%= container.empty_weight %></td>
        <td> 
          <%= link_to 'edit', edit_box_path(container),
                                id: "link_#{i}" %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
<%= will_paginate @boxes %>
<%= simple_form_for @application, html: {class: 'form-inline'} do |f| %>
  <%= f.error_notification %>
  <fieldset class='soil-application-fieldset'>
    <%= f.association :field, 
                collection: Field.all.sort_by(&:name_with_block), 
                label_method: :name_with_block,
                include_blank: false,
                wrapper_html: {class: 'col-xs-7 col-sm-5 col-md-4 col-lg-3'} %>
    <%= f.input :date,
                as: :string,
                input_html: { value: @application.formatted_date },
                wrapper_html: {class: 'col-xs-5 col-sm-4 col-md-7 nopadxs'} %>
    <%= f.association :soil_product, 
                collection: SoilProduct.all.sort_by(&:name),
                include_blank: false,
                wrapper_html: {class: 'col-xs-6 col-sm-4 col-md-3'} %>
    <%= f.input :quantity, as: :tel, 
                wrapper_html: {class: 'col-xs-2 col-sm-2 col-lg-1 nopadxs'} %>
    <%= f.association :soil_application_unit,
                collection: SoilApplicationUnit.all.sort_by(&:name),
                include_blank: false,
                label: 'Units',
                wrapper_html: {class: 'col-xs-3 nopadxs'} %>
  </fieldset>
  <%= f.button :submit, 'Save', class: 'btn-primary' %>
<% end %>
<div class="row">
 <div class="row col-md-6">
    <h1><%= @shipment.name %> Manifest</h1>
    
    <table id='lots' class='table table-striped'>
        <thead>
            <th> Lot Name</th>
            <th> Box Name</th>
        </thead>
        
        <tbody>
            <% @lots.each_with_index do |lot, l| %>
                <tr>
                    <td id="name<%=l%>"><%= lot.name %></td>  
                    <td id="name<%=l%>"><%= lot.box.name %></td>
                    
                    <%= link_to 'remove', 
                            edit_shipment_manifest_path(lot.id),
                            id: "link_#{l}",
                            class: 'btn-sm btn-primary',
                            role: 'button'
                    %>
                </tr>
            <% end %>
        </tbody>
    </table>
</div>
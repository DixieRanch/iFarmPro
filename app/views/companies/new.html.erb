<% provide :title, "Sign up" %>
<div class="col-xs-10 col-md-8">
  <div class="panel panel-primary">
    <div class="panel-heading"><h1>Sign up</h1></div>
    <div class="panel-body">
      <%= simple_form_for @company,
                          html: {class: 'form-horizontal'},
                          wrapper: :horizontal_form do |f| %>
        <%= f.error_notification %>
        <%= f.input :name, label: 'Company Name' %>
        <%= f.simple_fields_for :users do |u| %>
          <%= u.input :email %>
          <%= u.input :password %>
          <%= u.input :password_confirmation, label: 'Confirmation' %>
        <% end %>
        <%= f.submit "Create my account", class: "btn btn-lg btn-primary" %>
      <% end %>
    </div>
  </div>
</div>
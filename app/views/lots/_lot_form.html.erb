<%= simple_form_for @lot, html: {class: 'form-inline'} do |f| %>

  <fieldset>
    <%= f.input :name,
                label: 'Lot Name',
                wrapper_html: {class: 'col-xs-3'} %>
    
    <%= f.input :full_weight,
                label: 'Full Weight',
                wrapper_html: {class: 'col-xs-3'} %>
                
    <%= f.association :box,
                      collection: Box.all.sort_by(&:name),
                      lable_method: :name,
                      include_blank: false,
                      wrapper_html: 
                  {class: 'col-sm-2'} %>
                  
    <%= f.association :freezer_location,
                      collection: FreezerLocation.all.sort_by(&:name),
                      lable_method: :name,
                      include_blank: false,
                      wrapper_html: 
                  {class: 'col-sm-3'} %>   
                  
    <%= f.association :block,
                      collection: Block.all.sort_by(&:name),
                      lable_method: :name,
                      include_blank: false,
                      wrapper_html: 
                  {class: 'col-sm-3'} %> 
    
    <%= f.association :field,
                      collection: Field.all.sort_by(&:name),
                      lable_method: :name,
                      include_blank: false,
                      wrapper_html: 
                  {class: 'col-sm-3'} %> 
    
  </fieldset>
  
  <%= f.submit 'Save', class: 'btn btn-primary pull-left' %>
<% end %>
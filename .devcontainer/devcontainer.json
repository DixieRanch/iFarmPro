// .devcontainer/devcontainer.json
{
  "name": "Ruby 2.5 Dev Environment",
  "dockerComposeFile": "docker-compose.yml",
  "service": "dev-environment",
  "workspaceFolder": "/workspaces/iFarmPro",
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.shell.linux": "/bin/bash"
      }
    }
  },
  "postCreateCommand": "bundle install && bundle exec rake db:setup && bundle exec rake db:test:prepare && bundle exec rake db:seed RAILS_ENV=test"
}
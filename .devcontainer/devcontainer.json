// .devcontainer/devcontainer.json
{
  "name": "Ruby 3.1 Dev Environment",
  "dockerComposeFile": "docker-compose.yml",
  "service": "dev-environment",
  "workspaceFolder": "/workspaces/iFarmPro",
  "containerEnv": {
    "HEROKU_API_KEY": "${localEnv:HEROKU_API_KEY}"
  },
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.shell.linux": "/bin/bash"
      }
    }
  },
  "postCreateCommand": "bundle install && 
                        bundle exec rake db:setup && 
                        bundle exec rake db:test:prepare && 
                        bundle exec rake db:seed RAILS_ENV=test && 
                        git remote add heroku-staging https://:$HEROKU_API_KEY@git.heroku.com/ifarmpro-staging.git || true"
}